{
  "name": "nginx-web-ui-source",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.14.1+sha224.88b7a7244bbd9040380c417f7eb556d85c67640b651f113cb4c72113",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "storybook": "yarn workspace @repo/storybook run storybook",
    "build-storybook": "turbo run build-storybook"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "glob@npm:^13.0.1": "npm:14.0.2",
    "minimatch@npm:^10.2.2": "npm:11.0.1",
    "minimatch@npm:^11.0.0": "npm:11.0.1"
  }
}
