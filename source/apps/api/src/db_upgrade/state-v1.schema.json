  "title": "NWUI database upgrade public status and durable migration state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "pairId",
    "mode",
    "phase",
    "operation",
    "nextPhase",
    "ready",
    "source",
    "target",
    "inputsSha256",
    "destinations",
    "checks",
    "summary",
    "lastError"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "attemptId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pairId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "enum": [
        "migration",
        "fresh"
      ]
    },
    "phase": {
      "enum": [
        "not_started",
        "validated",
        "copied",
        "checked",
        "converted",
        "verified",
        "ready"
      ]
    },
    "operation": {
      "enum": [
        "idle",
        "running",
        "failed"
      ]
    },
    "nextPhase": {
      "anyOf": [
        {
          "enum": [
            "validated",
            "copied",
            "checked",
            "converted",
            "verified",
            "ready"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "architecture",
            "systemIdentifier",
            "manifestSha256",
            "backupId"
          ],
          "properties": {
            "major": {
              "const": 15
            },
            "architecture": {
              "enum": [
                "arm64",
                "amd64",
                "unrecorded"
              ]
            },
            "systemIdentifier": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "manifestSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "backupId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "architecture",
        "systemIdentifier"
      ],
      "properties": {
        "major": {
          "const": 17
        },
        "architecture": {
          "enum": [
            "arm64",
            "amd64"
          ]
        },
        "systemIdentifier": {
