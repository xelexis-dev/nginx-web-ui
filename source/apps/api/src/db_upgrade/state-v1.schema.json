                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "source"
                  ],
                  "properties": {
                    "kind": {
                      "const": "bind"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 4096,
                      "pattern": "^/[^\\u0000-\\u001f]*$"
