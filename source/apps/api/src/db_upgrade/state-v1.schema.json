      ]
    },
    "destinations": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "db",
            "app"
          ],
          "properties": {
            "db": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "source"
