#!/bin/sh
set -e
export PATH=/command:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
. /etc/s6-overlay/scripts/nwui-gate.sh
nwui_gate_longrun
. /etc/s6-overlay/scripts/pg-env.sh
# Keep offline exclusive operations out while the supervised postmaster or its backends live.
exec 9<"$PGROOT"
flock -s -n 9 || { echo storage_busy >&2; exit 1; }
# log_checkpoints 를 끄는 이유: 기본값이 on 인데, 접속 지표 수집이 들어오면서
# 이 DB 가 처음으로 상시 쓰기 부하를 받는다. checkpoint 가 하루 ≈0회에서 288회로
# 늘고 그때마다 로그 한 줄이 나가는데, 이 이미지에는 s6-log 가 없어 stderr 가
# Docker json-file 드라이버로 흘러가고 거기엔 크기 제한이 없다. 볼륨 네 개 어디에도
# 없고 백업에도 안 잡히고 보존 설정도 닿지 않는 곳에 연 ~50 MB 가 쌓인다.
# Supervise the postmaster directly: runuser force-kills its child after 2 seconds.
# JIT 파일은 이미지에 없다(Dockerfile nwui-no-jit). 켜 두어도 쓰이지 않으므로 상태를 명시한다.
exec /command/s6-setuidgid postgres "$PGBIN/postgres" -D "$PGDATA" \
  -c listen_addresses=127.0.0.1 \
  -c unix_socket_permissions=0700 \
  -c log_checkpoints=off \
  -c jit=off
