# Rust API only: disposable local-development PostgreSQL connection.
# The packaged image always uses its internal PostgreSQL.
DATABASE_URL=postgres://nginx:nginx@127.0.0.1:5432/nginx_web_ui
# Rust API session secret. The container generates and persists it on first boot.
# Never pass DATABASE_URL or AUTH_SECRET to Next.js.
AUTH_SECRET=
# Initial admin: supply both values, or leave password empty for web /setup.
# No admin password is generated or logged.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Rust API migration directory (set in the image)
MIGRATIONS_DIR=/app/drizzle
# Failed sign-ins are appended here for fail2ban (see docker/fail2ban/README.md).
# Outside the container this path is not writable — point it somewhere local in dev.
AUTH_LOG=/var/log/nginx-web-ui/auth.log
